{
  "name": "oobot",
  "version": "0.1.0",
  "private": true,
  "description": "oobot MVP — Object Oriented Robotics: a Java program controls a robot in a continuously running simulation, visible in a separate browser visualiser.",
  "workspaces": [
    "simulator/server",
    "simulator/visualiser"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "cd simulator/server && npm run dev",
    "dev:visualiser": "cd simulator/visualiser && npm run dev",
    "dev:robot": "node scripts/runRobot.js --behaviour wall-follow-right",
    "build:robot": "cd robot-framework && ./gradlew fatJar"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
