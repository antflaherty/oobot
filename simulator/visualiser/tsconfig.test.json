{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist-test",
    "declaration": false,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
